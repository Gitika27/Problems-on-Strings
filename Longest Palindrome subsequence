package CodingProblems;

import java.util.*;


public class LongestPalindromeSubsequence {

    public static int lcs(int i, int j, String s, ArrayList<Character> arr,int[][] dp){

        int n = s.length();

        if(i > j) return 0;

        if(i == j){
            return 1;
        }

        if(dp[i][j] != -1) return dp[i][j];

        if(s.charAt(i) == s.charAt(j)){
            return dp[i][j] = 2 + lcs(i+1,j-1,s,arr,dp);
        }
        else{
            int take = lcs(i+1,j,s,arr,dp);
            int notTake = lcs(i,j-1,s,arr,dp);

            return dp[i][j] =  Math.max(take, notTake);

        }

    }
    public static void main(String[] args) {

        String s = "bbbab";
        int n = s.length();

        int[][] dp = new int[n+1][n+1];

        for(int i = 0; i < n; i++){
            Arrays.fill(dp[i],-1);
        }
        System.out.println(lcs(0, n-1,s,new ArrayList<>(),dp));


    }
}
