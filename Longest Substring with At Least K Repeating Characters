class Solution {

    public int longestSubstringSolution(String s, int k) {

        int n = s.length();


        if(n < k ) return 0;

        HashMap<Character,Integer> freq = new HashMap<>();
        int sum = 0;
        for(char c : s.toCharArray()){
            freq.put(c, freq.getOrDefault(c,0) + 1);
        }

        for(Character c : freq.keySet()){
            if(freq.get(c) >= k)
            {
                sum += freq.get(c);
            }
        }
        for(int i = 0; i < n; i++){
            if(freq.get(s.charAt(i)) < k){
                int left = longestSubstringSolution(s.substring(0,i),k);
                int right = longestSubstringSolution(s.substring(i+1,n),k);
                return Math.max(left,right);
            }
        }
        return sum;
    }
    public int longestSubstring(String s, int k) {
        return longestSubstringSolution(s,k);
    }
}
