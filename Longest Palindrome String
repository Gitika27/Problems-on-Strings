class Solution {
    public String longestPalindrome(String s) {
        
        int len = 0;
        int n = s.length();
        String a = "";


        boolean[][] dp = new boolean[n][n];

        for(int i = 0; i < n; i++){
            dp[i][i] = true;
        }

        for(int i = n-1; i >= 0; i--){
            for(int j = i; j < n; j++){
                String word = s.substring(i,j+1);
                if(word.length() == 1){
                    dp[i][j] = true;
                    if(word.length() > a.length()){
                        a = word;
                    }
                }
                else if (word.length() == 2){
                    dp[i][j] = word.charAt(1) == word.charAt(0);
                    if(dp[i][j] && word.length() > a.length()){
                        a = word;
                    }
                }
                else{
                    if(s.charAt(j) == s.charAt(i)){
                        if(dp[i+1][j-1]){
                            dp[i][j] = true;
                            if(word.length() > a.length()){
                                a = word;
                            }
                        }
                    }
                    else{
                        dp[i][j] = false;
                    }
                }
            }
        }

        return a;
    }
}
